{
  "name": "snack-store",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "indexnow": "node scripts/submit-indexnow.js",
    "google-index": "node scripts/submit-google-indexing.js",
    "build": "npm run generate:sitemap && vite build && node scripts/prerender.js && node scripts/seo-qa.js",
    "deploy:seo": "npm run build && npm run indexnow && npm run google-index",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.31.0",
    "mercadopago": "^3.6.1",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "lightningcss": "^1.33.0",
    "oxlint": "^1.75.0",
    "vite": "^8.2.1"
  },
  "optionalDependencies": {
    "lightningcss-linux-x64-musl": "^1.33.0"
  }
}
