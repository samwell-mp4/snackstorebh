{
  "manifest_version": 3,
  "name": "Snack Store - Importador de Catálogo",
  "version": "1.0",
  "description": "Importa automaticamente produtos do e-commerce Snack Store BH para o catálogo do WhatsApp Web.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://snackstorebh.com.br/*",
    "https://web.whatsapp.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "popup.js", "products.js"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ]
}
